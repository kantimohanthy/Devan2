generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum EvidenceState {
  ENCOUNTERED
  STUDIED
  IMPLEMENTED
  TESTED
  APPLIED
  DEFENDED
}

enum LearningStatus {
  NOT_STARTED
  INTERESTED
  LEARNING
  PRACTICING
  APPLIED
  VERIFIED
  MASTERED
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  passwordHash  String
  role          Role     @default(VIEWER)
  headline      String?
  bio           String?
  location      String?
  website       String?
  avatar        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens RefreshToken[]
  projects      Project[]
  experiences   Experience[]
  education     Education[]
  skills        Skill[]
  auditLogs     AuditLog[]
  competencies  UserConceptCompetency[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Project {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  summary     String
  description String
  featured    Boolean   @default(false)
  github      String?
  liveDemo    String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  userId      String
  user        User      @relation(fields: [userId], references: [id])

  technologies ProjectTechnology[]
}

model Technology {
  id        String @id @default(cuid())
  name      String @unique
  icon      String?

  projects  ProjectTechnology[]
}

model ProjectTechnology {
  projectId     String
  technologyId  String

  project        Project    @relation(fields: [projectId], references: [id])
  technology     Technology @relation(fields: [technologyId], references: [id])

  @@id([projectId, technologyId])
}

model Skill {
  id        String @id @default(cuid())
  name      String
  category  String
  level     Int

  userId    String
  user      User @relation(fields: [userId], references: [id])
}

model Experience {
  id          String @id @default(cuid())
  company     String
  role        String
  startDate   DateTime
  endDate     DateTime?
  description String

  userId      String
  user        User @relation(fields: [userId], references: [id])
}

model Education {
  id          String @id @default(cuid())
  institution String
  degree      String
  field       String
  startYear   Int
  endYear     Int?

  userId      String
  user        User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  target    String?
  details   String?
  ipAddress String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model ProtocolTrace {
  id            String   @id @default(cuid())
  targetHost    String
  resolvedIp    String?
  totalDuration Int
  dnsMs         Int
  tcpMs         Int
  tlsMs         Int
  ttfbMs        Int
  tlsIssuer     String?
  asnNumber     String?
  asnOrg        String?
  stepDetails   String
  createdAt     DateTime @default(now())
}

model Experiment {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  title                 String
  category              String
  identityDimension     String
  objective             String
  problem               String
  motivation            String
  status                String
  evidenceScore         Int      @default(0)
  architectureDetails   String
  telemetrySpans        String
  benchmarksData        String
  tradeoffsData         String
  lessonsLearnedData    String
  githubRepo            String?
  relatedKnowledgeNodes String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Concept {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  domain         String
  topic          String?
  summary        String
  description    String
  evidenceState  EvidenceState @default(ENCOUNTERED)
  sourceRfc      String?
  observedResult String?
  whatBroke      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  relatedDecisions Decision[]
}

model Decision {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  context       String
  decision      String
  rationale     String
  tradeoffs     String   // JSON string of alternatives/tradeoffs array
  consequences   String?
  status        String   @default("ACCEPTED")
  conceptId     String?
  concept       Concept? @relation(fields: [conceptId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Repository {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  url              String
  description      String
  stars            Int      @default(0)
  forks            Int      @default(0)
  language         String
  ciStatus         String   @default("passing")
  openIssues       Int      @default(0)
  architectureNote String?
  isPrivate        Boolean  @default(false)
  evidenceCount    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Mission {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  objective       String
  domain          String
  progressPercent Int      @default(0)
  status          String   @default("IN_PROGRESS")
  checklistData   String   // JSON string of objectives array [{ label, done }]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserConceptCompetency {
  id              String         @id @default(cuid())
  userId          String
  conceptSlug     String
  learningStatus  LearningStatus @default(INTERESTED)
  knowledgeScore  Int            @default(0) // 0 - 10
  experienceScore Int            @default(0) // 0 - 10
  evidenceScore   Int            @default(0) // 0 - 10
  confidenceScore Int            @default(0) // 0 - 10
  lastAssessedAt  DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, conceptSlug])
}

model ExperienceEvent {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  entityId   String   // Refers to an Ontology entity (e.g. concept slug, project slug)
  action     String   // e.g. "COMPLETED_EXPERIMENT", "UPLOADED_EVIDENCE", "QUESTION_ASKED"
  metadata   String   // JSON string of event payload
  reason     String?
  source     String   @default("SYSTEM") // SYSTEM, USER, REASONER
  confidence Int      @default(100)      // 0 - 100
  createdAt  DateTime @default(now())
}